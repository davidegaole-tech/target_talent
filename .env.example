# Copia questo file in .env e modifica i valori se serve.
OLLAMA_URL=http://localhost:11434
QUADERNO_MODEL=qwen3:8b
QUADERNO_PORT=8765
QUADERNO_NUM_CTX=8192

# 127.0.0.1 = solo questo PC · 0.0.0.0 = raggiungibile anche dalla rete locale
QUADERNO_HOST=127.0.0.1

# Database: "mysql" (XAMPP) oppure "sqlite" (file locale, predefinito nei test)
TALENT_DB_DRIVER=mysql
TALENT_MYSQL_HOST=127.0.0.1
TALENT_MYSQL_PORT=3306
TALENT_MYSQL_USER=talent
TALENT_MYSQL_PASSWORD=cambia-questa-password
TALENT_MYSQL_DATABASE=talent_radar
# In alternativa al MySQL: TALENT_DB=data/talent.db con TALENT_DB_DRIVER=sqlite
